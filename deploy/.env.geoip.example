# Salin menjadi deploy/.env.geoip; isi hanya di VPS pusat.
MAXMIND_ACCOUNT_ID=replace-with-account-id
MAXMIND_LICENSE_KEY=replace-with-license-key

# Contoh resmi; pin versi atau digest yang sudah diuji sebelum deployment produksi.
GEOIPUPDATE_IMAGE=ghcr.io/maxmind/geoipupdate:latest
GEOIPUPDATE_FREQUENCY=24

# Relatif terhadap deploy/compose.geoip.yml, bukan direktori shell.
# Hasil default: <project>/data/geoip/staging
# Boleh diganti menjadi path absolut pada VPS pusat.
GEOIP_HOST_STAGING_DIR=../data/geoip/staging

# Same host root read/write by publisher and read-only by the optional API profile.
# Keep GEOIP_HOST_STAGING_DIR equal to <GEOIP_HOST_ROOT>/staging.
GEOIP_HOST_ROOT=../data/geoip
# Set to the owner of the private host directories (id -u / id -g).
CONTROL_UID=1000
CONTROL_GID=1000
