# Copy beside the verified Compose file. No token/credential belongs here.
# Use imageId from a verified image archive, or registry/repository@sha256 manifest digest.
AGENT_IMAGE=sha256:replace-with-verified-loaded-image-id
AGENT_CONFIG_PATH=/opt/shortlink-agent/config/agent.json
AGENT_DATA_PATH=/opt/shortlink-agent/data
AGENT_UID=10001
AGENT_GID=10001
AGENT_BIND_IP=127.0.0.1
AGENT_PORT=8091
