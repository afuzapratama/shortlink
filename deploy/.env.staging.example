# Independent staging instance; replace every placeholder before deploying.
CONTROL_MODE=production
CONTROL_LISTEN=127.0.0.1:8087
CONTROL_ORIGIN=https://stg-dashort.beon-api.site
CONTROL_PUBLIC_URL=https://stg-dashort.beon-api.site
DATABASE_URL='postgres://shortlink_staging:REPLACE_PASSWORD@127.0.0.1:5432/shortlink_staging?sslmode=disable'
GEOIP_ROOT=/var/lib/shortlink-staging/geoip
GEOIP_PUBLISH_ENABLED=false
AGENT_ASSET_ROOT=/var/lib/shortlink-staging/agent-assets
PHP_ASSET_ROOT=/var/lib/shortlink-staging/php-assets
RISK_FEED_ROOT=/var/lib/shortlink-staging/risk
SESSION_TTL=12h
