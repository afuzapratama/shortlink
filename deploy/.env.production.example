# Independent production instance; replace every placeholder before deploying.
# Live cutover uses port 8088; database/data paths retain legacy names to preserve identities.
# This template describes a fresh instance; do not overwrite the live private environment.
CONTROL_MODE=production
CONTROL_LISTEN=127.0.0.1:8088
CONTROL_ORIGIN=https://dashort.beon-api.site
CONTROL_PUBLIC_URL=https://dashort.beon-api.site
DATABASE_URL='postgres://shortlink_production:REPLACE_PASSWORD@127.0.0.1:5432/shortlink_production?sslmode=disable'
GEOIP_ROOT=/var/lib/shortlink-production/geoip
GEOIP_PUBLISH_ENABLED=false
AGENT_ASSET_ROOT=/var/lib/shortlink-production/agent-assets
PHP_ASSET_ROOT=/var/lib/shortlink-production/php-assets
RISK_FEED_ROOT=/var/lib/shortlink-production/risk
SESSION_TTL=12h
