# Copy to deploy/.env.control (ignored). Choose a private password; URL-encode it in DATABASE_URL.
POSTGRES_IMAGE=postgres:18.6
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_PORT=54329
DATABASE_URL='postgres://shortlink:replace-with-local-db-password@127.0.0.1:54329/shortlink?sslmode=disable'
# Development mode only accepts loopback listener/origin; HTTP cookie is allowed locally.
CONTROL_MODE=development
CONTROL_LISTEN=127.0.0.1:8080
CONTROL_ORIGIN=http://127.0.0.1:5173
SESSION_TTL=12h
# Origin is the browser-facing dashboard URL; Vite proxies /v1 and /health to CONTROL_LISTEN.
# Owner credentials are supplied once via the bootstrap command, not kept in this file.
# Production requires CONTROL_MODE=production and an HTTPS CONTROL_ORIGIN.

# Optional GeoLite filesystem root; use an absolute path when running on the host.
# In Docker this is /var/lib/shortlink/geoip, mounted as a directory.
GEOIP_ROOT=
# Enable only if this API process should also publish from staging (read/write mount).
# A separate watch-geoip process allows the API filesystem mount to remain read-only.
GEOIP_PUBLISH_ENABLED=false

# Canonical agent-facing API origin; defaults to CONTROL_ORIGIN. No path or credentials.
CONTROL_PUBLIC_URL=
# Absolute host path, or /var/lib/shortlink/agent-assets in a read-only API mount.
AGENT_ASSET_ROOT=
# Used only by control publish-agent; separate builder output directory.
AGENT_RELEASE_INPUT=

# B12 event retention (days); worker runs automatically with control serve.
EVENT_RAW_DAYS=7
EVENT_AGGREGATE_DAYS=90

# B13 signed risk bundle; absolute host path or a mounted path in the control container.
RISK_FEED_ROOT=
# Fixed official Tor HTTPS source; reputation import is a local staging file.
RISK_TOR_ENABLED=false

# B17 immutable PHP ZIP releases; separate from Go binaries/images.
PHP_ASSET_ROOT=
# Used only by control publish-php; output of scripts/build-php-release.py.
PHP_RELEASE_INPUT=
